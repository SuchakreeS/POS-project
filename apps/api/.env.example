# ---------- Database (Supabase) ----------
# Supabase → Project → Connect → "Transaction pooler" (port 6543). Used by the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Supabase → Project → Connect → "Session pooler" (port 5432). Used by Prisma migrate / seed.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------- Server ----------
PORT=4000
NODE_ENV=development
# The web app's URL (Vercel in production). Comma-separate several origins if needed.
CORS_ORIGIN="http://localhost:5173"

# ---------- Auth (used from step 2) ----------
# Long random strings, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# ---------- Seed (first admin user) ----------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# ---------- LINE daily report (used from step 10) ----------
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_GROUP_ID=""
REPORT_TIMEZONE="Asia/Bangkok"
# Protects /internal/* endpoints called by the scheduler
INTERNAL_JOB_SECRET="change-me-as-well"
